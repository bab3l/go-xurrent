# Copy to .env and fill in (do not commit .env).
# Load before running integration tests, e.g. PowerShell:
#   Get-Content .env | ForEach-Object { if ($_ -match '^\s*([^#][^=]*)=(.*)$') { Set-Item -Path "env:$($matches[1])" -Value $matches[2].Trim() } }
# Or use direnv / your IDE env loader.

# Required for authenticated production smoke tests (see test/integration/production_smoke_test.go)
XURRENT_TOKEN=
# Account id sent as X-4me-Account (must match where the token's person has roles)
XURRENT_ACCOUNT=

# Optional: comma-separated account ids that may appear on resource.account.id when it differs from
# XURRENT_ACCOUNT (trust / home-account). Lets integration probes and lifecycle person tests run
# without skipping (e.g. XURRENT_ACCOUNT=trimble-netops-test and XURRENT_TRUSTED_ACCOUNT_IDS=trimble).
XURRENT_TRUSTED_ACCOUNT_IDS=

# Phase 0 — POST /v1/services must succeed for the live-capture "spine" (service → offering → templates).
# Without configuration rights, PostServices returns 401/403 and GET sweeps skip /v1/services/{id}.
# Set to 1 and run: go test -tags=integration ./test/integration/ -run TestPhase0_PostServicesSpine -v -count=1
# Grant roles via UI or https://developer.xurrent.com/v1/people/permissions/ (e.g. configuration_manager).
XURRENT_PHASE0_POST_SERVICES=

# Optional: existing problem id in your tenant for GET /v1/problems/{id}
XURRENT_TEST_PROBLEM_ID=

# Optional: workflow id for GET /v1/workflows/{id} in endpoint coverage (test/integration/coverage_get_test.go)
XURRENT_TEST_WORKFLOW_ID=

# Optional: workflow template id (numeric) for workflow mutation tests and TestLifecycle_WorkflowArchiveRestoreTrash
XURRENT_TEST_WORKFLOW_TEMPLATE_ID=
# Optional: workflow_type for that test (default: application_change)
XURRENT_TEST_WORKFLOW_TYPE=

# Set to 1 to run POST/PATCH integration tests (test/integration/mutations_test.go)
XURRENT_ALLOW_MUTATIONS=

# Set to 1 with XURRENT_ALLOW_MUTATIONS=1 for extra POST/PATCH/PUT shape calls (test/integration/write_shape_coverage_test.go)
# for NDJSON live-shape capture (merge_skeleton_into_openapi.py).
XURRENT_WRITE_SHAPE_COVERAGE=

# Optional: seconds between outbound HTTP calls during integration when XURRENT_STRUCTURE_LOG_FILE is set (or always if set).
# Also enables 429 Retry-After + backoff (test/integration/integration_rate_limit_transport.go).
# utils/run_write_capture_cycle.py sets 0.4 when unset.
XURRENT_HTTP_MIN_INTERVAL=

# Optional: opt-in PostImport for write capture (test/integration/write_platform_capture_test.go); requires a valid CSV for your tenant.
XURRENT_WRITE_CAPTURE_POST_IMPORT=
XURRENT_WRITE_CAPTURE_IMPORT_CSV_PATH=
XURRENT_WRITE_CAPTURE_IMPORT_DATA_TYPE=

# Set to 1 so TestFixture_ParentIDsForCapture writes test/integration/_live_shapes/parent_fixture.env (or use live_capture_pipeline.py --parent-fixture).
XURRENT_BUILD_PARENT_FIXTURE=

# Optional: pin an open request id for request-scoped tests (also written by parent fixture when discoverable).
XURRENT_TEST_OPEN_REQUEST_ID=

# Set to 1 for archive/trash/restore lifecycle tests (test/integration/lifecycle_mutations_test.go)
XURRENT_ALLOW_LIFECYCLE_MUTATIONS=

# Optional: for TestLifecycle_RequestArchiveRestoreTrash (numeric ids from your tenant)
XURRENT_TEST_SERVICE_INSTANCE_ID=
# Optional: request template id (numeric) for TestLifecycle_RequestArchiveRestoreTrash
XURRENT_TEST_REQUEST_TEMPLATE_ID=

# Set to 1 for broad GET coverage against the live API (test/integration/coverage_get_test.go)
XURRENT_ENDPOINT_COVERAGE=

# Optional: NDJSON path for redacted JSON structure logs (no secrets; query values omitted).
# Used with: python utils/merge_skeleton_into_openapi.py
# Live capture pipeline sets this automatically: python utils/live_capture_pipeline.py
XURRENT_STRUCTURE_LOG_FILE=

# Optional: for utils/collect_live_response_shapes.py (GET sweep → merge into OpenAPI)
# XURRENT_API_BASE=https://api.xurrent.com
# XURRENT_SWEEP_DELAY=0.12
# utils/live_capture_pipeline.py sets 0.35 when unset; integration uses XURRENT_HTTP_MIN_INTERVAL (default 0.4 when unset).
# Optional: seconds to sleep before integration/sweep (cooldown after 429 / heavy use). Same as --pre-run-sleep on the pipeline.
# XURRENT_LIVE_CAPTURE_PRE_SLEEP=0
# (Legacy alias still read: XURRENT_PHASE1_PRE_SLEEP)

# Optional: pin real tenant ids for GET paths with {id} (leave unset to use list discovery). See docs/internal/GAP_GET_CAPTURE_IDS.md
# XURRENT_GAPTEST_AUTOMATION_RULE_ID=
# XURRENT_GAPTEST_CI_ID=
# XURRENT_GAPTEST_CONTRACT_ID=
# XURRENT_GAPTEST_FLSA_ID=
# XURRENT_GAPTEST_INVOICE_ID=
# XURRENT_GAPTEST_PERSON_ID=
# XURRENT_GAPTEST_PROBLEM_ID=
# XURRENT_GAPTEST_PROJECT_ID=
# XURRENT_GAPTEST_REQUEST_TEMPLATE_ID=
# XURRENT_GAPTEST_REQUEST_ID=
# XURRENT_GAPTEST_SERVICE_OFFERING_ID=
# XURRENT_GAPTEST_SERVICE_INSTANCE_ID=
# XURRENT_GAPTEST_SERVICE_ID=
# XURRENT_GAPTEST_SLA_ID=
# XURRENT_GAPTEST_SURVEY_ID=
# XURRENT_GAPTEST_UI_EXTENSION_ID=
# XURRENT_GAPTEST_WORKFLOW_ID=
# XURRENT_GAPTEST_CUSTOM_COLLECTION_ID=
# XURRENT_GAPTEST_CUSTOM_COLLECTION_ELEMENT_ID=
# XURRENT_GAPTEST_RESERVATION_ID=
# Optional sweep seeds (POST minimal rows when collections are empty — default ON; use collect --no-seed to disable):
# XURRENT_SWEEP_WORKFLOW_TEMPLATE_ID=   # numeric — enables POST /v1/workflows seed
# XURRENT_SWEEP_WORKFLOW_TYPE=application_change
# XURRENT_SWEEP_PRODUCT_ID=             # numeric — enables POST /v1/cis seed (needs service + team from other seeds)
